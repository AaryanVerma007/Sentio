# Flask Configuration
FLASK_SECRET_KEY=your_secure_flask_secret_key
DATABASE_URL=sqlite:///users.db

# InsForge Legacy Configuration (For non-auth DB tables)
API_BASE_URL=https://your-insforge-app.insforge.app
API_KEY=your_insforge_api_key

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# GOOGLE_REDIRECT_URI is dynamically handled by Authlib, but you can set it if needed

# Facebook OAuth Configuration
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
# FACEBOOK_REDIRECT_URI is dynamically handled by Authlib

# Resend API (For feedback emails)
RESEND_API_KEY=re_your_resend_api_key
SENDER_EMAIL=onboarding@resend.dev
